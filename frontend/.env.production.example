# ── Vercel Production Environment Variables ───────────────────────────────────
# Set these in: Vercel Dashboard → Project → Settings → Environment Variables

# Internal server-side URL used by Next.js rewrites (never exposed to browser).
# Set this to your Render backend URL.
BACKEND_URL=https://tradesense-backend.onrender.com

# Direct WebSocket URL — browsers connect here for live price feeds.
# Must be wss:// (secure WebSocket) in production.
NEXT_PUBLIC_WS_URL=wss://tradesense-backend.onrender.com

# Feature flags
NEXT_PUBLIC_PAPER_TRADING=true
NEXT_PUBLIC_AI_ASSISTANT=true
